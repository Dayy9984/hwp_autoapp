{
  "name": "inserty-desktop",
  "productName": "Inserty AI",
  "version": "0.1.9-beta.3",
  "main": "dist-electron/main/index.mjs",
  "description": "Inserty AI - AI 기반 문서 편집 솔루션",
  "author": "Inserty Team",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/Dayy9984/insertyai",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dayy9984/insertyai.git"
  },
  "bugs": {
    "url": "https://github.com/Dayy9984/insertyai/issues"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "electron-rebuild -f -w better-sqlite3 --runtime electron",
    "build:python": "cd python && uv run python build_python.py",
    "build": "pnpm build:python && tsc && vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.984.0",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^12.6.2",
    "builder-util-runtime": "9.3.1",
    "bytenode": "^1.3.6",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.562.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "3.6.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "asarmor": "^3.0.2",
    "autoprefixer": "^10.4.20",
    "bytenode": "^1.5.7",
    "electron": "^33.2.0",
    "electron-builder": "24.13.1",
    "javascript-obfuscator": "^5.1.0",
    "playwright": "^1.60.0",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.4.2",
    "v8-compile-cache": "^2.4.0",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.0.17"
  }
}