{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.inserty.ai",
  "productName": "Inserty AI",
  "asar": true,
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist-electron",
    "dist",
    "package.json",
    "node_modules/**",
    "!node_modules/**/*.map",
    "!node_modules/**/README.md",
    "!node_modules/**/CHANGELOG.md"
  ],
  "asarUnpack": [
    "**/*.node"
  ],
  "extraResources": [
    {
      "from": "python/dist/inserty_python",
      "to": "python/inserty_python",
      "filter": ["**/*", "!**/*.build/**", "!**/*.build"]
    },
    {
      "from": "python/dist/inserty_agent",
      "to": "python/inserty_agent",
      "filter": ["**/*", "!**/*.build/**", "!**/*.build"]
    },
    {
      "from": "python/dist/hwp_window_monitor",
      "to": "python/hwp_window_monitor",
      "filter": ["**/*", "!**/*.build/**", "!**/*.build"]
    },
    {
      "from": "python/dist/inserty_file_reader",
      "to": "python/inserty_file_reader",
      "filter": ["**/*", "!**/*.build/**", "!**/*.build"]
    }
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "Inserty-AI_${version}_Setup.${ext}"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "deleteAppDataOnUninstall": false,
    "uninstallDisplayName": "Inserty AI",
    "shortcutName": "Inserty AI",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerSidebar": "build/installer-sidebar.bmp",
    "installerHeader": "build/installer-header.bmp",
    "runAfterFinish": true,
    "include": "build/installer.nsh"
  },
  "publish": {
    "provider": "generic",
    "url": "https://inserty-beta-worker.snsoffice.workers.dev/auto-update/",
    "channel": "latest"
  }
}
